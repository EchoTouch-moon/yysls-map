{
  "name": "@yysls/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache fastapi dev app/main.py --host 127.0.0.1 --port 8000",
    "import:content": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache python -m app.content_import ../../content/yysls-qinghe-v4.json",
    "import:content:validate": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache python -m app.content_import ../../content/yysls-qinghe-v4.json --validate-only",
    "import:content:dry-run": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache python -m app.content_import ../../content/yysls-qinghe-v4.json --dry-run",
    "import:content:replace": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache python -m app.content_import ../../content/yysls-qinghe-v4.json --replace-existing --confirm-replace qinghe-chapter-1-v4",
    "lint": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache ruff check .",
    "format": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache ruff format .",
    "typecheck": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache mypy app",
    "test": "uv run --no-sync --cache-dir /tmp/yysls-map-uv-cache pytest",
    "build": "uv build"
  }
}
